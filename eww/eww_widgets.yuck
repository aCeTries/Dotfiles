(include "eww_vars.yuck")


(defwidget userinfobox []
    (box :height "30" :width "53" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww open powermenu" :class "button"
        (label :class "icon-label"  :text "⭘")
      )
    )
  )


(defwidget powermenu []
  (centerbox :height "30" :width "160" :halign "center" :valign "center" :class "userinfo-parent"
    (box :height "30" :width "53" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "systemctl poweroff" :class "poweroff-button"
        (label :class "icon-label"  :text "⏻")
      )
    )
    (box :height "30" :width "53" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "systemctl reboot"  :class "suspend-button"
        (label :class "icon-label"  :text "⭮")
      )
    )
    (box :height "30" :width "53" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww close powermenu" :class "button"
        (label :class "icon-label"  :text "⨯")
      )
    )
  )
)
