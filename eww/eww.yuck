(include "eww_widgets.yuck")

(defwindow userinfo
  :monitor '[0]'
  :stacking "overlay"
  :exclusive "false"
  :focusable "false"
  :visible "false"
  :geometry (geometry
    :x "0"
    :y "-60"
    :width "50"
    :height "30"
    :anchor "top center")
  (userinfobox)
)

(defwindow powermenu
  :monitor '[0]'
  :stacking "overlay"
  :namespace "eww"
  :exclusive false
  :geometry (geometry
    :x "50"
    :y "-60"
    :width "50"
    :height "300"
    :anchor "top center")
  (powermenu)
)
